# MyQRLWallet desktop: example environment.
# Copy to .env (gitignored) and adjust, or export the values in the shell that
# builds or runs the app. RPC values are read by the main process at startup
# (src/main/config.ts) and also derive the CSP connect-src allowlist, so only
# origins listed here can be reached by the renderer.

# ---------------------------------------------------------------------------
# Build time
# ---------------------------------------------------------------------------

# The network this build runs on: testnet (the default) or mainnet. Export it
# in the shell that runs `npm run build` or a `dist*` script. The chain ID,
# genesis hash, default RPC endpoints, QNS registry and data directory come
# from the network table in src/main/config.ts (NETWORKS); main, the wallet
# bridge and the bundled renderer all use that row. The value is baked into
# the build, so setting it at launch changes nothing. Mainnet is dormant: until
# its chain ID and genesis hash are filled in there, a mainnet build stops and
# a mainnet app refuses to start.
QRL_NETWORK_PROFILE=testnet

# ---------------------------------------------------------------------------
# Runtime (main process)
# ---------------------------------------------------------------------------

# Primary JSON-RPC endpoint (QRL v3, qrl_* namespace). Default: the wallet
# backend's RPC proxy for the build's network,
# https://qrlwallet.com/api/qrl-rpc/testnet or
# https://qrlwallet.com/api/qrl-rpc/mainnet. Every endpoint must serve the
# build's pinned chain ID and genesis hash; main checks both before account
# reads and broadcasts.
QRL_RPC_URL=https://qrlwallet.com/api/qrl-rpc/testnet

# Optional failover endpoint. Default on testnet: the dev backend's proxy.
# Mainnet has no failover by default. Set it to an empty string, "none" or
# "off" to disable failover. Its origin is also added to the CSP connect-src
# allowlist.
QRL_RPC_URL_SECONDARY=https://dev.qrlwallet.com/api/qrl-rpc/testnet

# Idle timeout in milliseconds before the signer auto-locks and zeroizes the
# in-memory session. Default is 300000 (5 minutes).
QRL_AUTOLOCK_MS=300000

# Allow the cross-platform safeStorage KEK vault (OS-key wrap, NO Touch ID /
# passcode prompt, readable by other code running as the same user). Set to
# "true" to permit it; leave unset/false to require the hardware-backed
# (macOS Keychain user-presence) vault. See src/keyvault/safeStorageVault.ts.
QRL_ALLOW_SAFESTORAGE=false

# ---------------------------------------------------------------------------
# macOS code-signing + notarization (afterSign hook: scripts/notarize.cjs)
# Uses an App Store Connect API key (.p8). Never commit these values.
# ---------------------------------------------------------------------------

# Absolute path to the App Store Connect API key file (AuthKey_XXXX.p8).
APPLE_API_KEY=
# The key id (the XXXX in the filename).
APPLE_API_KEY_ID=
# The issuer id (UUID) from App Store Connect.
APPLE_API_ISSUER=
# Apple Developer team id, used for the Developer ID signing identity.
APPLE_TEAM_ID=

# ---------------------------------------------------------------------------
# Windows code-signing (electron-builder win.signtoolOptions)
# ---------------------------------------------------------------------------

# Path to the code-signing certificate (.pfx) or a base64 of it.
WIN_CSC_LINK=
# Password for the certificate above.
WIN_CSC_KEY_PASSWORD=

# ---------------------------------------------------------------------------
# Detached PGP signing of build artifacts (afterAllArtifactBuild hook:
# scripts/pgp-sign.cjs)
# ---------------------------------------------------------------------------

# GPG key id (long id or fingerprint) used to produce .asc signatures.
GPG_KEY_ID=

# ---------------------------------------------------------------------------
# Optional: pin the macOS signing identity by name. electron-builder otherwise
# auto-discovers it from the keychain. Example: "Developer ID Application: ...".
# ---------------------------------------------------------------------------
CSC_NAME=
